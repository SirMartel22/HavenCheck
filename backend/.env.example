GEMMA_API_KEY=replace-me
OPENROUTER_API_KEY=your-openrouter-api-key-here
DATABASE_URL=postgresql://postgres:password@localhost:5432/housing_scout
RESEND_API_KEY=re_replace_me
AUTHORITY_EMAIL_TO=authority@example.com
SECURITY_EMAIL_TO=security@example.com
# Optional after verifying your sending domain in Resend:
RESEND_FROM_EMAIL=Housing Scout <alerts@yourdomain.com>
# Optional provider overrides:
GEMMA_MODEL=gemma-2-27b-it
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# GEMMA_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemma-2-27b-it:generateContent
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# Cloudinary configuration for image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Voice services (server-side only)
GROQ_API_KEY=your-groq-api-key
TTS_PROVIDER=easyvoice
EASYVOICE_API_KEY=your-easyvoice-api-key
EASYVOICE_API_URL=https://your-easyvoice-openai-compatible-tts-endpoint
EASYVOICE_MODEL=kokoro-82m
EASYVOICE_VOICE=af_aoede
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-premade-voice-id
